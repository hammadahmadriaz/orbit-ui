{
  "name": "orbitui-monorepo",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "docs": "pnpm --filter docs dev",
    "new:component": "node scripts/new-component.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @orbitdesign/ui build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.11.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver"
    ]
  }
}